{
  "expo": {
    "name": "Radar",
    "slug": "radar",
    "version": "2.9.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "radar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.michaldakowicz.radar",
      "versionCode": 15,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow Radar to save posters to your photos.",
          "photosPermission": "Allow Radar to access your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#3b82f6"
        }
      ],
      "./plugins/withUploadSigning",
      "./plugins/withTrimmedMediaPermissions"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "8bc8e954-9a7b-4985-b58f-142b8958f84a"
      }
    }
  }
}
